<Window x:Class="HermesLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HermesLauncher.ViewModels"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Assets/hermes-setup.ico"
        Title="Hermes Workspace Manager"
        Height="820" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgMainBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        AutomationProperties.Name="Hermes Workspace Manager">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/hermes-emblem.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HERMES" FontFamily="{StaticResource EditorialFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="WORKSPACE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,3,10,0" />
                    </StackPanel>
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="NOUS ENGINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="16" Padding="14,5" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="System health summary">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusOnlineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemHealthy}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SystemStatusSummary}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding UptimeText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding AvgLatencyText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="BtnMinimize_Click" Width="38" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" AutomationProperties.Name="Minimize window"><TextBlock Text="—" FontSize="11" /></Button>
                    <Button Click="BtnMaximize_Click" Width="38" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" AutomationProperties.Name="Maximize or restore window"><TextBlock Text="▢" FontSize="12" /></Button>
                    <Button Click="BtnClose_Click" Width="38" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" AutomationProperties.Name="Close window"><TextBlock Text="✕" FontSize="12" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="COMMANDS" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Open Workspace" Style="{StaticResource HermesSecondaryButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnQuickOpenWeb_Click" AutomationProperties.Name="Open workspace in browser" />
                    <Button Content="Restart Stack" Style="{StaticResource HermesSecondaryButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnRestartAll_Click" AutomationProperties.Name="Restart all services" />
                    <Button Content="Phone Pairing" Style="{StaticResource HermesSecondaryButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnGoToQr_Click" AutomationProperties.Name="Open phone pairing" />
                    <Button Content="Live Console" Style="{StaticResource HermesSecondaryButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnQuickGoLogs_Click" AutomationProperties.Name="Open live logs" />
                    <Button Content="Log Folder" Style="{StaticResource HermesSecondaryButton}" Padding="10,4" Click="BtnOpenLogsFolder_Click" AutomationProperties.Name="Open log folder" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Host" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4" Cursor="Hand" MouseDown="HostBadge_MouseDown" AutomationProperties.Name="Copy preferred host">
                        <TextBlock Text="{Binding PreferredHost}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,18,18,8">
                        <TextBlock Text="NAVIGATION" Style="{StaticResource SectionEyebrow}" />
                        <TextBlock Text="Keyboard: Tab / Arrow / Enter" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton Content="Services Dashboard" Style="{StaticResource NavTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=TwoWay}" Click="NavTab_Click" Tag="0" AutomationProperties.Name="Navigate to services dashboard" />
                        <RadioButton Content="Mobile Pairing" Style="{StaticResource NavTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=TwoWay}" Click="NavTab_Click" Tag="1" AutomationProperties.Name="Navigate to mobile pairing" />
                        <RadioButton Content="Install Wizard" Style="{StaticResource NavTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2, Mode=TwoWay}" Click="NavTab_Click" Tag="2" AutomationProperties.Name="Navigate to install wizard" />
                        <RadioButton Content="Live Console" Style="{StaticResource NavTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3, Mode=TwoWay}" Click="NavTab_Click" Tag="3" AutomationProperties.Name="Navigate to live console and logs" />
                        <RadioButton Content="Model &amp; Environment" Style="{StaticResource NavTabRadioButton}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=4, Mode=TwoWay}" Click="NavTab_Click" Tag="4" AutomationProperties.Name="Navigate to model and environment" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,18" Style="{StaticResource HermesCard}" Padding="14" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Network status">
                        <StackPanel>
                            <TextBlock Text="PAIRING NETWORK" Style="{StaticResource SectionEyebrow}" />
                            <TextBlock Text="{Binding PreferredHost}" FontSize="13" FontFamily="{StaticResource CodeFontFamily}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TailscaleStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24" x:Name="ContentHost" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.Resources>
                    <Style x:Key="PageGridStyle" TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="RenderTransform">
                            <Setter.Value><TranslateTransform Y="0" /></Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Dashboard -->
                <Grid Style="{StaticResource PageGridStyle}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource HermesCard}" Margin="0,0,0,18" AutomationProperties.Name="Dashboard overview">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Services Overview" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Gateway, Workspace, Agent dashboard and Ollama health with visible online/offline/checking feedback." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <UniformGrid Columns="3" Margin="0,16,0,0">
                                    <Border Style="{StaticResource PleasantOptionRow}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Readiness" Style="{StaticResource SectionEyebrow}" />
                                            <TextBlock Text="{Binding SystemStatusSummary}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PleasantOptionRow}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Latency" Style="{StaticResource SectionEyebrow}" />
                                            <TextBlock Text="{Binding AvgLatencyText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PleasantOptionRow}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="Install state" Style="{StaticResource SectionEyebrow}" />
                                            <TextBlock Text="Ready / Running / Cancelled / Failed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                                <Button Content="Start All" Style="{StaticResource HermesPrimaryButton}" Click="BtnStartAll_Click" Margin="0,0,8,8" AutomationProperties.Name="Start all services" />
                                <Button Content="Restart All" Style="{StaticResource HermesSecondaryButton}" Click="BtnRestartAll_Click" Margin="0,0,8,8" AutomationProperties.Name="Restart all services" />
                                <Button Content="Stop All" Style="{StaticResource HermesDangerButton}" Click="BtnStopAll_Click" AutomationProperties.Name="Stop all services" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InteractiveCard}" Margin="0,0,14,14" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource EditorialFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center" Padding="8,3">
                                                        <TextBlock Text="{Binding Port, StringFormat=':{0}'}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" Foreground="{StaticResource AccentPrimaryBrush}" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}" AutomationProperties.LiveSetting="Polite">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource StatusOnlineBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False"><Setter Property="Fill" Value="{StaticResource StatusOfflineBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusOnlineBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False"><Setter Property="Foreground" Value="{StaticResource StatusOfflineBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Grid Grid.Row="2" Margin="0,0,0,14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding EndpointLabel}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding DetectedModel, StringFormat='Engine: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <TextBlock Grid.Row="2" Text="{Binding LastChecked, StringFormat='Last check: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                            </Grid>
                                            <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                                <Button Content="Open" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,6,6" Tag="{Binding}" Click="BtnOpenBrowser_Click" AutomationProperties.Name="Open service endpoint" />
                                                <Button Content="Restart" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,6,6" Tag="{Binding}" Click="BtnRestartService_Click" AutomationProperties.Name="Restart service" />
                                                <Button Content="Start" Style="{StaticResource HermesPrimaryButton}" Margin="0,0,6,6" Tag="{Binding}" Click="BtnStartService_Click" AutomationProperties.Name="Start service" />
                                                <Button Content="Stop" Style="{StaticResource HermesDangerButton}" Tag="{Binding}" Click="BtnStopService_Click" AutomationProperties.Name="Stop service" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource HermesCard}" Margin="0,8,0,0" Padding="16,12" BorderBrush="{StaticResource BorderActiveBrush}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Pair your phone securely" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="QR/deep-link payload contains credentials: keep it masked, short-lived, and copy only when needed." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Content="Open Pairing Studio" Style="{StaticResource HermesPrimaryButton}" HorizontalAlignment="Right" Click="BtnGoToQr_Click" Padding="16,8" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Pairing -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="320" MaxWidth="390" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HermesCard}" Margin="0,0,18,0" BorderBrush="{StaticResource BorderActiveBrush}" AutomationProperties.Name="QR pairing code">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="PAIRING STUDIO" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                            <Border Width="280" Height="280" Background="#FFFFFF" CornerRadius="18" Padding="18" HorizontalAlignment="Center">
                                <Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pairing QR code contains hidden credentials" />
                            </Border>
                            <TextBlock Text="{Binding ExpiryLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CountdownText}" FontSize="12" FontFamily="{StaticResource CodeFontFamily}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource HermesCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Instant Mobile Pairing" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Scan in the Android app. Pairing data is masked by default because deep links and codes include connection secrets." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,18" TextWrapping="Wrap" />

                                <Border Background="#251A0C" BorderBrush="{StaticResource BorderWarningBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16" AutomationProperties.LiveSetting="Assertive">
                                    <TextBlock Text="Security warning: reveal or copy pairing data only on a trusted screen. Regenerate/expire the code if it was shared accidentally." FontSize="12" Foreground="{StaticResource StatusWarningBrush}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="DEEP LINK" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="DeepLinkPasswordBox" Style="{StaticResource HermesPasswordBox}" IsTabStop="False" AutomationProperties.Name="Masked deep link" />
                                    <TextBox x:Name="DeepLinkRevealTextBox" Text="{Binding DeepLink, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Visibility="Collapsed" AutomationProperties.Name="Revealed deep link" />
                                    <Button Grid.Column="1" Content="Show" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnToggleDeepLinkReveal_Click" AutomationProperties.Name="Show or hide deep link with warning" />
                                    <Button Grid.Column="2" Content="Copy" Style="{StaticResource HermesPrimaryButton}" Margin="8,0,0,0" Click="BtnCopyDeepLink_Click" AutomationProperties.Name="Copy deep link" />
                                </Grid>

                                <TextBlock Text="RAW PAIRING CODE" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ConnectCodePasswordBox" Style="{StaticResource HermesPasswordBox}" Height="56" IsTabStop="False" AutomationProperties.Name="Masked pairing code" />
                                    <TextBox x:Name="ConnectCodeRevealTextBox" Text="{Binding ConnectCode, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Height="56" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.Name="Revealed pairing code" />
                                    <Button Grid.Column="1" Content="Show" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnToggleConnectCodeReveal_Click" AutomationProperties.Name="Show or hide pairing code with warning" />
                                    <Button Grid.Column="2" Content="Copy" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnCopyCode_Click" AutomationProperties.Name="Copy pairing code" />
                                </Grid>

                                <TextBlock Text="REGENERATE / EXPIRE" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,18">
                                    <Button Content="24 Hours" Style="{StaticResource HermesPrimaryButton}" Margin="0,0,8,8" Click="BtnRegen24h_Click" />
                                    <Button Content="7 Days" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,8,8" Click="BtnRegen7d_Click" />
                                    <Button Content="30 Days" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,8,8" Click="BtnRegen30d_Click" />
                                    <Button Content="Permanent Local" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,8,8" Click="BtnRegenNever_Click" />
                                </WrapPanel>

                                <Border Style="{StaticResource PleasantOptionRow}">
                                    <StackPanel>
                                        <TextBlock Text="Tailscale connection guide" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Keep both devices in the same Tailnet, open Hermes Android, tap Scan QR, then aim at the code. Prefer expiring tokens for shared or support sessions." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Install wizard -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource HermesCard}" Margin="0,0,0,14" Padding="16" AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Install Wizard" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Diagnostics → Paths &amp; Components → Provider → Deploy" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10" />
                                <ProgressBar Value="{Binding InstallProgress}" Maximum="1.0" Style="{StaticResource HermesProgressBar}" AutomationProperties.Name="Installation progress" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding CurrentStepTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource HermesCard}" Margin="0,0,0,14" Padding="10">
                        <UniformGrid Columns="4">
                            <RadioButton Style="{StaticResource WizardStepRadioButton}" IsChecked="{Binding SetupWizardStep, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=TwoWay}" Tag="0" Click="WizardStepTab_Click" Content="1  Diagnostics" AutomationProperties.Name="Wizard step diagnostics" />
                            <RadioButton Style="{StaticResource WizardStepRadioButton}" IsChecked="{Binding SetupWizardStep, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=TwoWay}" Tag="1" Click="WizardStepTab_Click" Content="2  Paths &amp; Components" AutomationProperties.Name="Wizard step paths and components" />
                            <RadioButton Style="{StaticResource WizardStepRadioButton}" IsChecked="{Binding SetupWizardStep, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2, Mode=TwoWay}" Tag="2" Click="WizardStepTab_Click" Content="3  Provider" AutomationProperties.Name="Wizard step provider" />
                            <RadioButton Style="{StaticResource WizardStepRadioButton}" IsChecked="{Binding SetupWizardStep, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3, Mode=TwoWay}" Tag="3" Click="WizardStepTab_Click" Content="4  Deploy" AutomationProperties.Name="Wizard step deploy" />
                        </UniformGrid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Border Style="{StaticResource HermesCard}" Visibility="{Binding SetupWizardStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="Loading: checks in progress. Success: green badge. Failure: red badge with recommendation. Empty: no checks generated yet." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Prerequisites}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PleasantOptionRow}" Margin="0,0,10,10" AutomationProperties.Name="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,3" />
                                                            <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource StatusOnlineBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="False"><Setter Property="Fill" Value="{StaticResource StatusOfflineBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding VersionOrStatus}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HermesCard}" Visibility="{Binding SetupWizardStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="Paths &amp; Components" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Use flexible paths and select optional modules. Disabled states remain readable and keyboard accessible." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />
                                <TextBlock Text="INSTALLATION PATHS" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Install Directory" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" AutomationProperties.Name="Install directory" /></Grid>
                                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Workspace Directory" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding WorkspaceDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" AutomationProperties.Name="Workspace directory" /></Grid>
                                <TextBlock Text="COMPONENTS" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource PleasantOptionRow}"><Grid><StackPanel><TextBlock Text="Tailscale Mesh Networking" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Encrypted phone-to-PC connection via 100.x IP." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><CheckBox IsChecked="{Binding InstallTailscale}" Style="{StaticResource HermesCheckBox}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Install Tailscale" /></Grid></Border>
                                <Border Style="{StaticResource PleasantOptionRow}"><Grid><StackPanel><TextBlock Text="Ollama Local LLM Runner" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Offline GPU/CPU model inference on localhost:11434." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><CheckBox IsChecked="{Binding InstallOllama}" Style="{StaticResource HermesCheckBox}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Install Ollama" /></Grid></Border>
                                <Border Style="{StaticResource PleasantOptionRow}"><Grid><StackPanel><TextBlock Text="MemOS Long-term Memory Plugin" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Persistent hierarchical memory for Nous agent sessions." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><CheckBox IsChecked="{Binding InstallMemOS}" Style="{StaticResource HermesCheckBox}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Install MemOS" /></Grid></Border>
                                <Border Style="{StaticResource PleasantOptionRow}"><Grid><StackPanel><TextBlock Text="Obsidian &amp; Skills Pack" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Knowledge base integration and automated skills." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><CheckBox IsChecked="{Binding InstallObsidian}" Style="{StaticResource HermesCheckBox}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Install Obsidian" /></Grid></Border>
                                <Border Style="{StaticResource PleasantOptionRow}"><Grid><StackPanel><TextBlock Text="Windows Firewall Rules" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Allows ports 3000, 8642 and 9119 for the selected Hermes services." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel><CheckBox IsChecked="{Binding ConfigureFirewall}" Style="{StaticResource HermesCheckBox}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Configure firewall" /></Grid></Border>
                            </StackPanel></ScrollViewer>
                        </Border>

                        <Border Style="{StaticResource HermesCard}" Visibility="{Binding SetupWizardStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="Provider" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Provider key uses a PasswordBox and is hidden by default. No raw secret is rendered unless Show is explicitly pressed." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Provider Preset" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><ComboBox Grid.Column="1" ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding SelectedProviderPreset, Mode=TwoWay}" AutomationProperties.Name="Provider preset" /></Grid>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Base API URL" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding ProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" AutomationProperties.Name="Provider base URL" /></Grid>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Provider API Key" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><PasswordBox x:Name="ProviderApiKeyPasswordBox" Grid.Column="1" Style="{StaticResource HermesPasswordBox}" PasswordChanged="ProviderApiKeyPasswordBox_PasswordChanged" AutomationProperties.Name="Masked provider API key" /><TextBox x:Name="ProviderApiKeyRevealTextBox" Grid.Column="1" Text="{Binding ProviderApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Visibility="Collapsed" AutomationProperties.Name="Revealed provider API key" /><Button Grid.Column="2" Content="Show" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnToggleProviderApiKeyReveal_Click" AutomationProperties.Name="Show or hide provider API key" /></Grid>
                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Default Model ID" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding ProviderModelName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" AutomationProperties.Name="Default model ID" /></Grid>
                                <Border Background="#251A0C" BorderBrush="{StaticResource BorderWarningBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><TextBlock Text="Secret safety: copy/reveal actions show neutral feedback only; raw .env values remain masked unless the field is not secret-like." FontSize="12" Foreground="{StaticResource StatusWarningBrush}" TextWrapping="Wrap" /></Border>
                            </StackPanel></ScrollViewer>
                        </Border>

                        <Border Style="{StaticResource HermesCard}" Background="{StaticResource BgTerminalBrush}" Visibility="{Binding SetupWizardStep, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Deploy" Style="{StaticResource PageTitle}" /><TextBlock Text="{Binding CurrentStepTitle}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" AutomationProperties.LiveSetting="Assertive" /><ProgressBar Value="{Binding InstallProgress}" Maximum="1.0" Style="{StaticResource HermesProgressBar}" Margin="0,8,0,0" /></StackPanel><WrapPanel Grid.Column="1" Margin="14,0,0,0"><Button Content="Copy Output" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,6,6" Click="BtnCopyInstallerLogs_Click" /><Button Content="Clear" Style="{StaticResource HermesSecondaryButton}" Click="BtnClearInstallerLogs_Click" /></WrapPanel></Grid>
                                <Border Grid.Row="1" Background="{StaticResource TerminalHeaderBrush}" Padding="12,7" Margin="-18,0,-18,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,1"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource StatusOfflineBrush}" Margin="0,0,5,0" VerticalAlignment="Center" /><Ellipse Width="7" Height="7" Fill="{StaticResource StatusWarningBrush}" Margin="0,0,5,0" VerticalAlignment="Center" /><Ellipse Width="7" Height="7" Fill="{StaticResource StatusOnlineBrush}" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="LIVE INSTALLATION LOG • REDACTED/COPY-SAFE OUTPUT EXPECTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" /></StackPanel></Border>
                                <TextBox x:Name="TxtInstallerLogs" Grid.Row="2" Text="{Binding InstallerLogText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource StatusOnlineBrush}" BorderThickness="0" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="TxtInstallerLogs_TextChanged" AutomationProperties.Name="Installer logs" AutomationProperties.LiveSetting="Polite" />
                                <Border Background="#33111A" BorderBrush="#66503A45" BorderThickness="1" CornerRadius="12" Padding="14" Visibility="{Binding ShowInstallErrorPanel, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="520" Margin="0,0,12,12" AutomationProperties.LiveSetting="Assertive">
                                    <StackPanel><TextBlock Text="Failure report available" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StatusOfflineBrush}" /><TextBlock Text="{Binding InstallErrorReport}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="120" /><WrapPanel Margin="0,8,0,0"><Button Content="Open Error Report" Style="{StaticResource HermesSecondaryButton}" Margin="0,0,8,0" Click="BtnOpenErrorReport_Click" /><Button Content="Retry" Style="{StaticResource HermesPrimaryButton}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" Click="BtnRetryInstall_Click" /></WrapPanel></StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="4,0">
                        <Grid>
                            <WrapPanel HorizontalAlignment="Left"><Button Content="Back" Style="{StaticResource HermesSecondaryButton}" Click="BtnWizardPrev_Click" Margin="0,0,8,8" /><Button Content="Next" Style="{StaticResource HermesSecondaryButton}" Click="BtnWizardNext_Click" Margin="0,0,8,8" /><Button Content="Re-run Diagnostics" Style="{StaticResource HermesSecondaryButton}" Click="BtnRefreshDiagnostics_Click" /></WrapPanel>
                            <WrapPanel HorizontalAlignment="Right"><Button Content="Start Deployment" Style="{StaticResource HermesPrimaryButton}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" Click="BtnStartInstall_Click" Margin="0,0,8,8" /><Button Content="Clean Reinstall" Style="{StaticResource HermesSecondaryButton}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" Click="BtnCleanReinstall_Click" Margin="0,0,8,8" /><Button Content="Full Uninstall" Style="{StaticResource HermesDangerButton}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}" Click="BtnFullUninstall_Click" Margin="0,0,8,8" AutomationProperties.Name="Completely remove Hermes from this computer" /><Button Content="Cancel" Style="{StaticResource HermesDangerButton}" IsEnabled="{Binding IsInstalling}" Click="BtnCancelInstall_Click" /></WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Logs -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource HermesCard}" Margin="0,0,0,12" Padding="14">
                        <Grid><WrapPanel VerticalAlignment="Center"><TextBlock Text="LOG TARGET" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox ItemsSource="{Binding AvailableLogs}" SelectedItem="{Binding SelectedLogName, Mode=TwoWay}" Width="210" AutomationProperties.Name="Log target" /><TextBlock Text="FILTER" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center" Margin="14,0,8,0" /><TextBox Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" Width="190" Height="34" Padding="8,4" AutomationProperties.Name="Log filter" /><Button Content="Refresh" Style="{StaticResource HermesSecondaryButton}" Margin="10,0,0,0" Click="BtnRefreshLogs_Click" /><Button Content="Copy Visible" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnCopyVisibleLog_Click" /></WrapPanel><Button Content="Open Folder" Style="{StaticResource HermesSecondaryButton}" HorizontalAlignment="Right" Click="BtnOpenLogsFolder_Click" /></Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource HermesCard}" Background="{StaticResource BgTerminalBrush}">
                        <TextBox x:Name="TxtVisibleLogs" Text="{Binding LogViewerContent, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource StatusOnlineBrush}" BorderThickness="0" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Log viewer" />
                    </Border>
                </Grid>

                <!-- Model & environment -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=4}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource HermesCard}" Margin="0,0,0,14" BorderBrush="{StaticResource BorderActiveBrush}">
                        <StackPanel>
                            <TextBlock Text="Model &amp; Environment" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Provider fields are editable; secrets stay masked by default. Environment editor masks secret-like values and preserves existing bindings." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Provider Preset" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><ComboBox Grid.Column="1" ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding SelectedProviderPreset, Mode=TwoWay}" /><Button Grid.Column="2" Content="Apply &amp; Restart Gateway" Style="{StaticResource HermesPrimaryButton}" Margin="12,0,0,0" Click="BtnApplyProvider_Click" /></Grid>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Base API URL" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding ProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" /></Grid>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Provider API Key" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><PasswordBox x:Name="ProviderApiKeyPasswordBoxEnv" Grid.Column="1" Style="{StaticResource HermesPasswordBox}" PasswordChanged="ProviderApiKeyPasswordBox_PasswordChanged" AutomationProperties.Name="Masked provider API key" /><TextBox x:Name="ProviderApiKeyRevealTextBoxEnv" Grid.Column="1" Text="{Binding ProviderApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Visibility="Collapsed" /><Button Grid.Column="2" Content="Show" Style="{StaticResource HermesSecondaryButton}" Margin="8,0,0,0" Click="BtnToggleProviderApiKeyReveal_Click" /></Grid>
                            <Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Target Model ID" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox Grid.Column="1" Text="{Binding ProviderModelName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" /></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource HermesCard}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12"><StackPanel><TextBlock Text="RAW .ENV EDITOR" Style="{StaticResource SectionEyebrow}" /><TextBlock Text="Secret-like keys are masked in UI; editing their real value requires coder-provided safe reveal/edit contract." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel><Button Content="Save All Env Keys" Style="{StaticResource HermesSecondaryButton}" HorizontalAlignment="Right" Click="BtnSaveEnv_Click" /></Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding EnvEntries}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Key}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HermesTextBox}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Loaded="EnvValueTextBox_Loaded" AutomationProperties.Name="Environment value masked when secret" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="14" Padding="14,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Notification">
                    <TextBlock Text="{Binding CopyNotification}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
