<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern Hermes design tokens: deep navy surfaces, one cyan accent, semantic colors only for state. -->
    <Color x:Key="BgMainColor">#08111F</Color>
    <Color x:Key="BgSidebarColor">#060D18</Color>
    <Color x:Key="BgCardColor">#0E192B</Color>
    <Color x:Key="BgCardHoverColor">#13223A</Color>
    <Color x:Key="BgCardSelectedColor">#172A46</Color>
    <Color x:Key="BgInputColor">#0A1424</Color>
    <Color x:Key="BgTerminalColor">#050B13</Color>
    <Color x:Key="BgOverlayColor">#CC08111F</Color>

    <Color x:Key="BorderSubtleColor">#1D2B43</Color>
    <Color x:Key="BorderCardColor">#2B3B55</Color>
    <Color x:Key="BorderActiveColor">#38BDF8</Color>
    <Color x:Key="BorderWarningColor">#80F59E0B</Color>

    <Color x:Key="AccentPrimaryColor">#38BDF8</Color>
    <Color x:Key="AccentPrimaryHoverColor">#7DD3FC</Color>
    <Color x:Key="AccentPrimaryPressedColor">#0284C7</Color>
    <Color x:Key="AccentPrimaryTextColor">#03101A</Color>

    <Color x:Key="TextPrimaryColor">#F2F7FB</Color>
    <Color x:Key="TextSecondaryColor">#B7C4D4</Color>
    <Color x:Key="TextMutedColor">#7C8CA3</Color>
    <Color x:Key="StatusOnlineColor">#34D399</Color>
    <Color x:Key="StatusOfflineColor">#F87171</Color>
    <Color x:Key="StatusWarningColor">#FBBF24</Color>
    <Color x:Key="StatusInfoColor">#60A5FA</Color>
    <Color x:Key="StatusCancelledColor">#A78BFA</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgCardSelectedBrush" Color="{StaticResource BgCardSelectedColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgTerminalBrush" Color="{StaticResource BgTerminalColor}" />
    <SolidColorBrush x:Key="BgOverlayBrush" Color="{StaticResource BgOverlayColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderCardBrush" Color="{StaticResource BorderCardColor}" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource BorderActiveColor}" />
    <SolidColorBrush x:Key="BorderWarningBrush" Color="{StaticResource BorderWarningColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="{StaticResource AccentPrimaryTextColor}" />

    <!-- Backward-compatible aliases for existing bindings/styles while unifying the palette. -->
    <SolidColorBrush x:Key="BorderYellowBrush" Color="{StaticResource BorderActiveColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentYellowHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentYellowPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnlineColor}" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusCancelledBrush" Color="{StaticResource StatusCancelledColor}" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="0.55" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="YellowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="0.55" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B1526" Offset="0" />
        <GradientStop Color="#07101D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111F34" Offset="0" />
        <GradientStop Color="#0C1728" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TerminalHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#09111D" Offset="0" />
        <GradientStop Color="#050B13" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="EditorialFontFamily">Segoe UI Variable Display, Aptos Display, Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MainFontFamily">Segoe UI Variable Text, Aptos, Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Code, JetBrains Mono, Consolas, monospace</FontFamily>

    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">24</Thickness>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>
    <Duration x:Key="MotionFast">0:0:0.16</Duration>
    <Duration x:Key="MotionNormal">0:0:0.22</Duration>

    <Style x:Key="FocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{StaticResource AccentPrimaryBrush}" StrokeThickness="2" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style x:Key="HermesPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#162235" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HermesSecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#091426" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#0B1422" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#182438" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HermesDangerButton" TargetType="Button" BasedOn="{StaticResource HermesSecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource StatusOfflineBrush}" />
        <Setter Property="Background" Value="#2A1119" />
        <Setter Property="BorderBrush" Value="#59303B" />
    </Style>

    <Style x:Key="HermesTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B4F6D" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#07101B" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HermesPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B4F6D" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#07101B" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HermesCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="box" Width="20" Height="20" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1.5" CornerRadius="6" Margin="0,0,10,0">
                            <Path x:Name="check" Data="M 4,10 L 8,14 L 16,5" Stroke="{StaticResource AccentPrimaryTextBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter TargetName="box" Property="Background" Value="#07101B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTabRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Margin="10,3" Padding="0">
                        <Grid>
                            <Border x:Name="pill" Width="4" Height="24" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" Margin="20,0,12,0" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardSelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WizardStepRadioButton" TargetType="RadioButton" BasedOn="{StaticResource NavTabRadioButton}">
        <Setter Property="MinHeight" Value="52" />
    </Style>

    <Style x:Key="HermesProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="#07101B" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HermesCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource HermesCard}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PleasantOptionRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="#142238" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SectionEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EditorialFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
